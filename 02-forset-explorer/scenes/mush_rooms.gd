# Этот скрипт управляет 2D-объектом в игре (например, предметом на карте)
extends Node2D 

# Переменная-идентификатор предмета. 
# Аннотация @export позволяет менять это значение (например, на 'coin' или 'potion') 
# прямо в инспекторе Godot без изменения самого кода.
@export var item_id: String = 'mushrooms' 


# Эта функция автоматически вызывается движком (через сигнал), 
# когда любой физический объект (коллайдер) пересекает зону Area2D этого предмета.
# Параметр 'body' — это ссылка на тот самый объект, который вошел в зону.
func _on_area_2d_body_entered(body: Node2D) -> void: 
	
	# Проверяем, совпадает ли имя вошедшего объекта со строкой 'Player'.
	# Это нужно, чтобы предмет реагировал только на главного героя, а не на врагов или физические коробки.
	if body.name == 'Player': 
		
		# Обращаемся к глобальному скрипту (автозагрузке) Global и активируем сигнал item_collected.
		# Передаем в этот сигнал название нашего предмета (item_id), чтобы игра знала, что именно подобрали.
		Global.item_collected.emit(item_id) 
		
		# Безопасно удаляем этот предмет из игрового мира (из дерева узлов) в конце текущего кадра.
		# Благодаря этому предмет исчезает с экрана и больше не занимает память.
		queue_free()
